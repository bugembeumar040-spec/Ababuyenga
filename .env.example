# Copy to .env and fill in. .env is gitignored and must never be committed.
# In GitHub Actions these come from repository secrets instead of this file.

# From Google Cloud Console -> Google Auth Platform -> Clients
# MUST be a client of type "TVs and Limited Input devices".
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# Produced by:  node scripts/yt.mjs connect
YT_REFRESH_TOKEN=
